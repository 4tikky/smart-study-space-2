# Salin ke frontend/.env.local. Nilai VITE_* bersifat publik dan ditanam saat build.
VITE_RUNTIME=browser
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Jangan pernah menaruh service_role atau secret key di frontend.
# run-dev.bat memilih VITE_RUNTIME=legacy untuk FastAPI lokal.
# SSS_BACKEND_URL=http://127.0.0.1:8000
